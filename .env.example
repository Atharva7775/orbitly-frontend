# Base URL of orbitly-backend (FastAPI). All /api/* calls are made against this host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Static asset host used for product images and catalog bundles.
NEXT_PUBLIC_ASSET_BASE=https://cdn.orbitly.example

# Card tokenization runs against the PayStream sandbox outside production.
NEXT_PUBLIC_PAYMENTS_ENV=sandbox
